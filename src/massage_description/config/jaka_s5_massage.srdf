<?xml version="1.0" encoding="UTF-8"?>
<robot name="jaka_s5">
  <group name="jaka_s5">
    <joint name="fixed"/>
    <joint name="joint_1"/>
    <joint name="joint_2"/>
    <joint name="joint_3"/>
    <joint name="joint_4"/>
    <joint name="joint_5"/>
    <joint name="joint_6"/>
  </group>

  <group_state name="zero" group="jaka_s5">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="0"/>
    <joint name="joint_3" value="0"/>
    <joint name="joint_4" value="0"/>
    <joint name="joint_5" value="0"/>
    <joint name="joint_6" value="0"/>
  </group_state>
  <group_state name="pose_1" group="jaka_s5">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="1.5707"/>
    <joint name="joint_3" value="-1.5707"/>
    <joint name="joint_4" value="1.5707"/>
    <joint name="joint_5" value="1.5707"/>
    <joint name="joint_6" value="0"/>
  </group_state>

  <disable_collisions link1="Link_00" link2="Link_01" reason="Adjacent"/>
  <disable_collisions link1="Link_01" link2="Link_02" reason="Adjacent"/>
  <disable_collisions link1="Link_01" link2="Link_04" reason="Never"/>
  <disable_collisions link1="Link_02" link2="Link_03" reason="Adjacent"/>
  <disable_collisions link1="Link_03" link2="Link_04" reason="Adjacent"/>
  <disable_collisions link1="Link_03" link2="Link_05" reason="Never"/>
  <disable_collisions link1="Link_04" link2="Link_05" reason="Adjacent"/>
  <disable_collisions link1="Link_04" link2="Link_06" reason="Never"/>
  <disable_collisions link1="Link_05" link2="Link_06" reason="Adjacent"/>
  <disable_collisions
      link1="Link_06"
      link2="massage_head_link"
      reason="Adjacent"/>
