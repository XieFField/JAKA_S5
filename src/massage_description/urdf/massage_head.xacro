<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 项目按摩头：圆柱从安装面沿局部 +Z 延伸 80 mm。 -->
  <xacro:macro name="massage_head" params="parent_link wrench_topic">
    <link name="massage_head_link">
      <visual>
        <origin xyz = "0 0 0.04" rpy = "0 0 0"/>
        <geometry>
          <cylinder radius="0.03" length="0.08"/>
        </geometry>
        <material name="massage_head_color">
           <color rgba="0.2 0.6 0.8 1.0"/>
          </material>
        </visual>

      <collision>
        <origin xyz = "0 0 0.04" rpy = "0 0 0"/>
        <geometry>
          <cylinder radius="0.03" length="0.08"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz = "0 0 0.04" rpy = "0 0 0"/>
        <mass value="0.2"/>
        <inertia
            ixx="0.000151667"
            ixy="0.0"
            ixz="0.0"
            iyy="0.000151667"
            iyz="0.0"
            izz="0.00009"/>
        </inertial>
      </link>
    <joint name="ft_sensor_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent_link}"/>
      <child link="massage_head_link"/>
    </joint>

    <!-- 规划和工艺统一使用按摩头接触端面中心，不再使用法兰 Link_06。 -->
    <link name="massage_tool_tip"/>
    <joint name="massage_tool_tip_joint" type="fixed">
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <parent link="massage_head_link"/>
      <child link="massage_tool_tip"/>
    </joint>

    <gazebo reference="ft_sensor_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
      <sensor name="massage_ft_sensor" type="force_torque">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>${wrench_topic}</topic>

        <force_torque>
          <frame>child</frame>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
