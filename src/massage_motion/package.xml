<?xml version="1.0"?>
<package format="3">
  <name>massage_motion</name>
  <version>0.1.0</version>
  <description>Basic motion planning types and interfaces for the massage robot project.</description>
  <maintainer email="3432674139@qq.com">xieffield</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>interactive_markers</depend>
  <depend>control_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>yaml_cpp_vendor</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>srdfdom</test_depend>
  <test_depend>urdf</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
